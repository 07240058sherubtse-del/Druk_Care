<%- include('partials/header') %>
<section class="section-space"><div class="container"><div class="card doctor-profile"><div class="row g-0 align-items-center"><div class="col-md-4"><div class="profile-photo"><% if (doctor.photoUrl) { %><img src="<%= doctor.photoUrl %>" alt="Portrait of <%= doctor.name %>"><% } else { %><i class="bi bi-person"></i><% } %></div></div><div class="col-md-8"><div class="card-body p-lg-5"><span class="eyebrow"><%= doctor.Department.name %></span><h1 class="mt-2"><%= doctor.title ? doctor.title + ' ' : '' %><%= doctor.name %></h1><p class="lead text-secondary"><%= doctor.Hospital.name %> · <%= doctor.Hospital.Dzongkhag.name %></p><p><%= doctor.bio || 'Profile information has not been provided by this facility.' %></p><h2 class="h5 mt-4">Consultation availability</h2><% if (doctor.Availabilities.length) { %><ul class="list-unstyled"><% doctor.Availabilities.forEach((a) => { %><li><i class="bi bi-clock me-2 text-teal"></i><%= ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][a.dayOfWeek] %>, <%= a.startTime.slice(0,5) %>–<%= a.endTime.slice(0,5) %></li><% }) %></ul><% } else { %><p class="text-secondary">The facility has not supplied a schedule.</p><% } %><% if (doctor.Hospital.verified && doctor.Hospital.bookingEnabled && doctor.Availabilities.length) { %><a class="btn btn-primary btn-lg mt-2" href="/book/<%= doctor.id %>">Book an appointment</a><% } else { %><p class="alert alert-info mt-3 mb-0">Online appointment booking is not currently available for this profile.</p><% } %></div></div></div></div></div></section>
<%- include('partials/footer') %>
