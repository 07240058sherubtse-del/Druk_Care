<%- include('partials/header') %>
<section class="section-space"><div class="container"><div class="auth-card"><span class="eyebrow">Update your visit</span><h1>Reschedule appointment</h1><p class="text-secondary"><%= appointment.reference %> · <%= appointment.Doctor.name %></p><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %><form id="booking-form" method="post" action="/appointments/<%= appointment.id %>/reschedule" data-doctor-id="<%= appointment.doctorId %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label" for="date">New date</label><input class="form-control" id="date" name="date" type="date" required></div><div class="mb-3"><label class="form-label" for="time">Available time</label><select class="form-select" id="time" name="time" required disabled><option value="">Select a date first</option></select><div id="slot-status" class="form-text" aria-live="polite"></div></div><button class="btn btn-primary w-100" id="book-submit" disabled>Confirm new time</button></form></div></div></section>
<%- include('partials/footer') %>
