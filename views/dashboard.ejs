<%- include('partials/header') %>
<section class="page-hero"><div class="container"><span class="eyebrow">Patient dashboard</span><h1>Welcome, <%= currentUser.name %></h1><p>Review and manage your DrukCare appointments.</p><div class="d-flex gap-2"><a class="btn btn-outline-primary btn-sm" href="/profile">Edit profile</a><a class="btn btn-outline-primary btn-sm" href="/change-password">Change password</a></div></div></section>
<section class="section-space pt-4"><div class="container"><div class="d-flex justify-content-between align-items-center mb-4"><h2 class="h3 mb-0">My appointments</h2><a href="/doctors" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Book a visit</a></div>
  <% if (appointments.length) { %><div class="row g-4"><% appointments.forEach((appointment) => { %><div class="col-lg-6"><article class="card appointment-card"><div class="card-body p-4"><div class="d-flex justify-content-between gap-2"><div><span class="small text-teal fw-semibold"><%= appointment.reference %></span><h3 class="h5 mt-1"><%= appointment.Doctor.name %></h3></div><span class="badge rounded-pill align-self-start <%= appointment.status === 'confirmed' ? 'text-bg-success' : appointment.status === 'cancelled' ? 'text-bg-secondary' : 'text-bg-primary' %>"><%= appointment.status %></span></div><p class="text-secondary mb-2"><%= appointment.Doctor.Department.name %> · <%= appointment.Doctor.Hospital.name %></p><p class="mb-3"><i class="bi bi-calendar3 me-2 text-teal"></i><%= appointment.appointmentDate %> at <%= appointment.time.slice(0,5) %> Bhutan Time</p><% if (appointment.reason) { %><p class="small text-secondary"><%= appointment.reason %></p><% } %><% if (['pending','confirmed'].includes(appointment.status)) { %><div class="d-flex gap-2"><a class="btn btn-outline-primary btn-sm" href="/appointments/<%= appointment.id %>/reschedule">Reschedule</a><form method="post" action="/appointments/<%= appointment.id %>/cancel" data-confirm="Cancel this appointment?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-danger btn-sm">Cancel appointment</button></form></div><% } %></div></article></div><% }) %></div><% } else { %><div class="empty-state"><i class="bi bi-calendar2-heart"></i><h2>No appointments yet</h2><p>Browse verified doctors to see currently available online booking slots.</p><a class="btn btn-primary" href="/doctors">Find a doctor</a></div><% } %>
</div></section>
<%- include('partials/footer') %>
