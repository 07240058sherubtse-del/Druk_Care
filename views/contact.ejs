<%- include('partials/header') %>
<section class="page-hero"><div class="container"><span class="eyebrow">We are here to help</span><h1>Contact DrukCare</h1><p>Send a message to our team. Do not include sensitive medical information.</p></div></section>
<section class="section-space pt-4"><div class="container"><div class="auth-card mx-auto"><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %><form method="post" action="/contact"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label" for="name">Name</label><input class="form-control" id="name" name="name" maxlength="120" autocomplete="name" required></div><div class="mb-3"><label class="form-label" for="email">Email</label><input class="form-control" id="email" name="email" type="email" maxlength="254" autocomplete="email" required></div><div class="mb-3"><label class="form-label" for="message">Message</label><textarea class="form-control" id="message" name="message" maxlength="2000" rows="6" required></textarea></div><button class="btn btn-primary w-100">Send message</button></form></div></div></section>
<%- include('partials/footer') %>
