<%- include('partials/header') %>
<section class="page-hero"><div class="container"><span class="eyebrow">Administration</span><h1>DrukCare dashboard</h1><p>Manage verified directory information, schedules and appointments.</p></div></section>
<section class="section-space pt-4"><div class="container">
  <div class="row g-3 mb-5"><% Object.entries(stats).forEach(([label, count]) => { %><div class="col-6 col-lg"><div class="admin-stat"><span><%= label %></span><strong><%= count %></strong></div></div><% }) %></div>
  <div class="row g-4 mb-5">
    <div class="col-lg-6"><div class="admin-panel"><h2 class="h4">Add a hospital</h2><p class="small text-secondary">New facilities remain unverified and are not public until reviewed.</p><form method="post" action="/admin/hospitals"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label" for="hospital-name">Facility name</label><input class="form-control" id="hospital-name" name="name" maxlength="160" required></div><div class="mb-3"><label class="form-label" for="hospital-dzongkhag">Dzongkhag</label><select class="form-select" id="hospital-dzongkhag" name="dzongkhagId" required><option value="">Select</option><% dzongkhags.forEach((d) => { %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select></div><div class="mb-3"><label class="form-label" for="address">Address</label><input class="form-control" id="address" name="address" maxlength="255"></div><div class="row"><div class="col"><label class="form-label" for="phone">Phone</label><input class="form-control" id="phone" name="phone" maxlength="40"></div><div class="col"><label class="form-label" for="website">Website</label><input class="form-control" id="website" name="website" maxlength="255" type="url"></div></div><div class="mt-3 mb-3"><label class="form-label" for="sourceUrl">Verification source URL</label><input class="form-control" id="sourceUrl" name="sourceUrl" maxlength="500" type="url"></div><button class="btn btn-primary">Add unverified hospital</button></form></div></div>
    <div class="col-lg-6"><div class="admin-panel"><h2 class="h4">Hospital verification</h2><% if (hospitalList.length) { %><div class="admin-list"><% hospitalList.forEach((h) => { %><form class="admin-list-row" method="post" action="/admin/hospitals/<%= h.id %>/verify"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><strong><%= h.name %></strong><div class="small text-secondary"><%= h.Dzongkhag.name %> · <%= h.verified ? 'Verified' : 'Unverified' %><% if (h.sourceUrl) { %> · <a href="<%= h.sourceUrl %>" target="_blank" rel="noopener noreferrer">Source</a><% } %></div></div><div class="d-flex flex-column align-items-end gap-2"><label class="form-check small"><input class="form-check-input" type="checkbox" name="bookingEnabled" <%= h.bookingEnabled ? 'checked' : '' %>> Online booking</label><button class="btn btn-sm <%= h.verified ? 'btn-outline-secondary' : 'btn-outline-primary' %>"><%= h.verified ? 'Save status' : 'Verify' %></button></div></form><% }) %></div><% } else { %><p class="text-secondary mb-0">No facilities added.</p><% } %></div></div>
  </div>
  <div class="row g-4 mb-5">
    <div class="col-lg-4"><div class="admin-panel"><h2 class="h4">Add department</h2><form method="post" action="/admin/departments"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label" for="department-name">Name</label><input class="form-control" id="department-name" name="name" maxlength="100" required></div><div class="mb-3"><label class="form-label" for="department-description">Description</label><textarea class="form-control" id="department-description" name="description" rows="2"></textarea></div><button class="btn btn-primary">Add department</button></form></div></div>
    <div class="col-lg-8"><div class="admin-panel"><h2 class="h4">Add a doctor</h2><p class="small text-secondary">Doctor listings must reflect verified facility information.</p><form method="post" action="/admin/doctors"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-3"><div class="col-md-6"><label class="form-label" for="doctor-name">Name</label><input class="form-control" id="doctor-name" name="name" maxlength="120" required></div><div class="col-md-6"><label class="form-label" for="doctor-title">Professional title (optional)</label><input class="form-control" id="doctor-title" name="title" maxlength="80"></div><div class="col-md-6"><label class="form-label" for="doctor-hospital">Verified hospital</label><select class="form-select" id="doctor-hospital" name="hospitalId" required><option value="">Select</option><% hospitalList.filter((h) => h.verified).forEach((h) => { %><option value="<%= h.id %>"><%= h.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label" for="doctor-department">Department</label><select class="form-select" id="doctor-department" name="departmentId" required><option value="">Select</option><% departmentList.forEach((d) => { %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select></div><div class="col-12"><label class="form-label" for="doctor-bio">Profile information</label><textarea class="form-control" id="doctor-bio" name="bio" maxlength="5000" rows="2"></textarea></div></div><button class="btn btn-primary mt-3">Add doctor</button></form></div></div>
  </div>
  <div class="admin-panel mb-5"><h2 class="h4">Manage doctor availability</h2><% if (doctorList.length) { %><div class="admin-list"><% doctorList.forEach((d) => { %><form class="admin-list-row schedule-form" method="post" action="/admin/doctors/<%= d.id %>/availability"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><strong><%= d.name %></strong><div class="small text-secondary"><%= d.Hospital.name %> · <%= d.Department.name %></div></div><div class="schedule-fields"><select class="form-select form-select-sm" name="dayOfWeek" aria-label="Weekday"><option value="1">Monday</option><option value="2">Tuesday</option><option value="3">Wednesday</option><option value="4">Thursday</option><option value="5">Friday</option><option value="6">Saturday</option><option value="0">Sunday</option></select><input class="form-control form-control-sm" name="startTime" type="time" required aria-label="Start time"><input class="form-control form-control-sm" name="endTime" type="time" required aria-label="End time"><select class="form-select form-select-sm" name="slotMinutes" aria-label="Slot duration"><option value="15">15 min</option><option value="20" selected>20 min</option><option value="30">30 min</option><option value="45">45 min</option><option value="60">60 min</option></select><button class="btn btn-sm btn-outline-primary">Add schedule</button></div></form><% }) %></div><% } else { %><p class="text-secondary">Add a doctor profile first.</p><% } %></div>
  <div class="admin-panel mb-5"><h2 class="h4">Appointments</h2><% if (recentAppointments.length) { %><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Reference</th><th>Patient</th><th>Provider</th><th>Visit</th><th>Status</th><th>Update</th></tr></thead><tbody><% recentAppointments.forEach((a) => { %><tr><td><strong><%= a.reference %></strong></td><td><%= a.User.name %><div class="small text-secondary"><%= a.User.email %></div></td><td><%= a.Doctor.name %><div class="small text-secondary"><%= a.Doctor.Hospital.name %></div></td><td><%= a.appointmentDate %><br><span class="small"><%= a.time.slice(0,5) %></span></td><td><span class="badge text-bg-light"><%= a.status %></span></td><td><form method="post" action="/admin/appointments/<%= a.id %>/status" class="d-flex gap-1"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select class="form-select form-select-sm" name="status"><option value="confirmed">Confirm</option><option value="cancelled">Cancel</option><option value="completed">Complete</option></select><button class="btn btn-sm btn-outline-primary">Save</button></form></td></tr><% }) %></tbody></table></div><% } else { %><p class="text-secondary">No appointments yet.</p><% } %></div>
  <div class="admin-panel"><h2 class="h4">User accounts</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Action</th></tr></thead><tbody><% users.forEach((user) => { %><tr><td><%= user.name %></td><td><%= user.email %></td><td><%= user.role %></td><td><%= user.isActive ? 'Active' : 'Disabled' %></td><td><form method="post" action="/admin/users/<%= user.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="isActive" value="<%= user.isActive ? 'false' : 'true' %>"><button class="btn btn-sm btn-outline-secondary" <%= user.id === currentUser.id ? 'disabled' : '' %>><%= user.isActive ? 'Disable' : 'Enable' %></button></form></td></tr><% }) %></tbody></table></div></div>
</div></section>
<%- include('partials/footer') %>
