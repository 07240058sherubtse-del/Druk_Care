<%- include('partials/header') %>
<section class="page-hero"><div class="container"><span class="eyebrow"><%= hospital.Dzongkhag.name %></span><h1><%= hospital.name %></h1><p><%= hospital.address || 'Address details have not been provided.' %></p></div></section>
<section class="section-space"><div class="container"><div class="row g-5"><div class="col-lg-4"><div class="admin-panel"><div class="facility-icon"><i class="bi bi-hospital"></i></div><h2 class="h5">Facility details</h2><% if (hospital.phone) { %><p><i class="bi bi-telephone me-2 text-teal"></i><a href="tel:<%= hospital.phone %>"><%= hospital.phone %></a></p><% } %><% if (hospital.website) { %><p><i class="bi bi-globe me-2 text-teal"></i><a href="<%= hospital.website %>" target="_blank" rel="noopener noreferrer">Facility website</a></p><% } %><span class="badge <%= hospital.bookingEnabled ? 'text-bg-success' : 'text-bg-light' %>"><%= hospital.bookingEnabled ? 'Online booking enabled' : 'No online schedule provided' %></span></div></div><div class="col-lg-8"><h2 class="h3 mb-4">Doctors at this facility</h2><% if (doctors.length) { %><div class="row g-3"><% doctors.forEach((doctor) => { %><div class="col-md-6"><article class="card doctor-card h-100"><div class="card-body"><div class="doctor-avatar mb-3"><% if (doctor.photoUrl) { %><img src="<%= doctor.photoUrl %>" alt="Portrait of <%= doctor.name %>"><% } else { %><i class="bi bi-person"></i><% } %></div><span class="badge text-bg-light align-self-start"><%= doctor.Department.name %></span><h3 class="h5 mt-2"><%= doctor.name %></h3><p class="small text-secondary"><% if (doctor.Availabilities.length) { %><%= [...new Set(doctor.Availabilities.map((a) => ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][a.dayOfWeek]))].join(', ') %><% } else { %>Schedule not provided<% } %></p><a class="btn btn-outline-primary mt-auto" href="/doctors/<%= doctor.id %>">View doctor</a></div></article></div><% }) %></div><% } else { %><div class="empty-state"><i class="bi bi-person-vcard"></i><h3>No doctor schedules listed</h3><p>This facility has not supplied verified doctor information for DrukCare.</p></div><% } %></div></div></div></section>
<%- include('partials/footer') %>
