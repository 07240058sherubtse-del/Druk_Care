<%- include('../partials/header') %>
<section class="auth-section"><div class="auth-card"><span class="eyebrow">Account recovery</span><h1>Choose a new password</h1><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %><form method="post" action="/reset-password/<%= token %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label" for="password">New password</label><input class="form-control" id="password" name="password" type="password" minlength="10" maxlength="128" autocomplete="new-password" required><div class="form-text">Use at least 10 characters.</div></div><button class="btn btn-primary w-100">Update password</button></form></div></section>
<%- include('../partials/footer') %>
