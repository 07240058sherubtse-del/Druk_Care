<%- include('../partials/header') %>
<section class="auth-section"><div class="auth-card"><span class="eyebrow">Account recovery</span><h1>Reset your password</h1><p class="text-secondary">Enter your account email and we will send a reset link if it matches an account.</p><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %><form method="post" action="/forgot-password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label" for="email">Email address</label><input class="form-control" id="email" name="email" type="email" autocomplete="email" required></div><button class="btn btn-primary w-100">Send reset link</button></form><a class="small d-block text-center mt-3" href="/login">Return to sign in</a></div></section>
<%- include('../partials/footer') %>
