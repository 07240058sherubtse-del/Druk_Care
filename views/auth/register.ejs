<%- include('../partials/header') %>
<section class="auth-section"><div class="auth-card"><span class="eyebrow">Get started</span><h1>Create your account</h1><p class="text-secondary">Manage appointment bookings securely.</p><% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %><form method="post" action="/register"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label" for="name">Full name</label><input class="form-control" id="name" name="name" maxlength="120" autocomplete="name" required></div><div class="mb-3"><label class="form-label" for="email">Email address</label><input class="form-control" id="email" name="email" type="email" maxlength="254" autocomplete="email" required></div><div class="mb-3"><label class="form-label" for="phone">Phone (optional)</label><input class="form-control" id="phone" name="phone" type="tel" maxlength="30" autocomplete="tel"></div><div class="mb-3"><label class="form-label" for="password">Password</label><input class="form-control" id="password" name="password" type="password" minlength="10" maxlength="128" autocomplete="new-password" required><div class="form-text">Use at least 10 characters.</div></div><button class="btn btn-primary btn-lg w-100">Create account</button></form><p class="small text-center mt-3 mb-0">Already registered? <a href="/login">Sign in</a></p></div></section>
<%- include('../partials/footer') %>
