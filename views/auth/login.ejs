<%- include('../partials/header') %>
<section class="auth-section"><div class="auth-card"><span class="eyebrow">Welcome back</span><h1>Sign in</h1><p class="text-secondary">Access your DrukCare appointments.</p><% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %><form method="post" action="/login"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label" for="email">Email address</label><input class="form-control form-control-lg" id="email" name="email" type="email" autocomplete="email" required></div><div class="mb-3"><label class="form-label" for="password">Password</label><input class="form-control form-control-lg" id="password" name="password" type="password" autocomplete="current-password" required></div><button class="btn btn-primary btn-lg w-100">Sign in</button></form><div class="d-flex justify-content-between mt-3 small"><a href="/forgot-password">Forgot password?</a><a href="/register">Create account</a></div></div></section>
<%- include('../partials/footer') %>
