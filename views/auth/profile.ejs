<%- include('../partials/header') %>
<section class="auth-section"><div class="auth-card"><span class="eyebrow">Personal details</span><h1>Edit profile</h1><p class="text-secondary">Your sign-in email cannot be changed here.</p><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %><form method="post" action="/profile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label" for="name">Full name</label><input class="form-control" id="name" name="name" maxlength="120" value="<%= user.name %>" required></div><div class="mb-3"><label class="form-label" for="email">Email</label><input class="form-control" id="email" value="<%= user.email || currentUser.email %>" disabled></div><div class="mb-3"><label class="form-label" for="phone">Phone</label><input class="form-control" id="phone" name="phone" maxlength="30" value="<%= user.phone || '' %>"></div><button class="btn btn-primary w-100">Save profile</button></form></div></section>
<%- include('../partials/footer') %>
