<%- include('partials/header') %>
<section class="page-hero"><div class="container"><span class="eyebrow">Appointment booking</span><h1>Choose a visit time</h1><p><%= doctor.name %> · <%= doctor.Hospital.name %> · <%= doctor.Department.name %></p></div></section>
<section class="section-space pt-4"><div class="container"><div class="booking-layout"><div class="card booking-card"><div class="card-body p-4 p-lg-5"><div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Times are shown in Bhutan Time (Asia/Thimphu). Your appointment is not booked until you confirm.</div><form id="booking-form" method="post" action="/book/<%= doctor.id %>" data-doctor-id="<%= doctor.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-4"><label class="form-label fw-semibold" for="date">Appointment date</label><input class="form-control form-control-lg" id="date" name="date" type="date" required></div><div class="mb-4"><label class="form-label fw-semibold" for="time">Available time</label><select class="form-select form-select-lg" id="time" name="time" required disabled><option value="">Select a date first</option></select><div id="slot-status" class="form-text" aria-live="polite"></div></div><div class="mb-4"><label class="form-label fw-semibold" for="reason">Reason for visit <span class="text-secondary fw-normal">(optional)</span></label><textarea class="form-control" id="reason" name="reason" rows="3" maxlength="500" placeholder="Share a brief note for the care team"></textarea></div><button class="btn btn-primary btn-lg w-100" id="book-submit" disabled>Confirm appointment</button></form></div></div><aside class="card provider-summary"><div class="card-body"><div class="doctor-avatar mb-3"><i class="bi bi-person"></i></div><h2 class="h5"><%= doctor.title ? doctor.title + ' ' : '' %><%= doctor.name %></h2><p class="text-secondary"><%= doctor.Department.name %></p><hr><p><i class="bi bi-hospital me-2 text-teal"></i><%= doctor.Hospital.name %></p><p><i class="bi bi-geo-alt me-2 text-teal"></i><%= doctor.Hospital.Dzongkhag.name %></p></div></aside></div></div></section>
<%- include('partials/footer') %>
