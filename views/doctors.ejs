<%- include('partials/header') %>
<section class="page-hero"><div class="container"><span class="eyebrow">Meet your care team</span><h1>Find doctors</h1><p>Browse doctor profiles and see who has confirmed online booking availability.</p></div></section>
<section class="section-space pt-4"><div class="container">
  <form class="filter-panel row g-3 align-items-end mb-4" method="get">
    <div class="col-md-4"><label class="form-label" for="q">Doctor name</label><input id="q" name="q" class="form-control" value="<%= typeof query !== 'undefined' ? query.q : '' %>" placeholder="Search doctors"></div>
    <div class="col-md-3"><label class="form-label" for="department">Department</label><select class="form-select" id="department" name="department"><option value="">All departments</option><% departments.forEach((d) => { %><option value="<%= d.id %>" <%= typeof query !== 'undefined' && query.department === d.id ? 'selected' : '' %>><%= d.name %></option><% }) %></select></div>
    <div class="col-md-3"><label class="form-label" for="hospital">Hospital</label><select class="form-select" id="hospital" name="hospital"><option value="">All hospitals</option><% hospitals.forEach((h) => { %><option value="<%= h.id %>" <%= typeof query !== 'undefined' && query.hospital === h.id ? 'selected' : '' %>><%= h.name %></option><% }) %></select></div>
    <div class="col-md-2 d-grid"><button class="btn btn-primary">Search</button></div>
  </form>
  <% if (doctors.length) { %><div class="row g-4"><% doctors.forEach((doctor) => { %><div class="col-md-6 col-lg-4"><article class="card doctor-card h-100"><div class="doctor-avatar"><% if (doctor.photoUrl) { %><img src="<%= doctor.photoUrl %>" alt="Portrait of <%= doctor.name %>"><% } else { %><i class="bi bi-person"></i><% } %></div><div class="card-body"><span class="badge text-bg-light"><%= doctor.Department.name %></span><h2 class="h5 mt-3 mb-1"><%= doctor.title ? doctor.title + ' ' : '' %><%= doctor.name %></h2><p class="text-secondary mb-2"><i class="bi bi-hospital me-1"></i><%= doctor.Hospital.name %> · <%= doctor.Hospital.Dzongkhag.name %></p><p class="small text-secondary"><i class="bi bi-calendar-week me-1"></i><% if (doctor.Availabilities.length) { %><%= [...new Set(doctor.Availabilities.map((a) => ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][a.dayOfWeek]))].join(', ') %><% } else { %>Schedule not provided<% } %></p><div class="d-flex gap-2 mt-auto"><a class="btn btn-outline-primary flex-fill" href="/doctors/<%= doctor.id %>">View profile</a><% if (doctor.Hospital.bookingEnabled && doctor.Hospital.verified && doctor.Availabilities.length) { %><a class="btn btn-primary flex-fill" href="/book/<%= doctor.id %>">Book</a><% } else { %><button class="btn btn-light flex-fill" disabled>Booking unavailable</button><% } %></div></div></article></div><% }) %></div>
  <% } else { %><div class="empty-state"><i class="bi bi-person-vcard"></i><h2>No doctor profiles available yet</h2><p>Only profiles supplied by verified facilities will appear here. Please check back soon.</p></div><% } %>
</div></section>
<%- include('partials/footer') %>
