<%- include('partials/header') %>
<section class="auth-section"><div class="auth-card text-center"><div class="success-icon"><i class="bi bi-check2"></i></div><span class="eyebrow">Booking details</span><h1>Appointment confirmed</h1><p class="text-secondary">Your appointment is reserved with the verified provider.</p><div class="confirmation-box text-start"><div><span>Reference</span><strong><%= appointment.reference %></strong></div><div><span>Doctor</span><strong><%= doctor.name %></strong></div><div><span>Hospital</span><strong><%= doctor.Hospital.name %></strong></div><div><span>Date &amp; time</span><strong><%= appointment.appointmentDate %> at <%= appointment.time.slice(0,5) %> (Bhutan Time)</strong></div></div><% if (!emailSent) { %><p class="alert alert-warning mt-3">The appointment is booked, but we could not send the confirmation email. Please keep your reference number.</p><% } else { %><p class="small text-secondary mt-3">A confirmation has been sent to your registered email.</p><% } %><a class="btn btn-primary w-100" href="/dashboard">View my appointments</a></div></section>
<%- include('partials/footer') %>
